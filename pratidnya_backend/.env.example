# Pratidnya Legal NLP Microservice - Environment Configuration
APP_ENV=DEVELOPMENT
PORT=8000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PAID_TIER=false
ENFORCE_DUMMY_DATA=true

# Kanoon.dev Integration
KANOON_DEV_API_KEY=sk_mock_test_key
MOCK_KANOON_API=true

# Supabase PostgreSQL (ap-south-1 Mumbai)
SUPABASE_URL=https://edekorlixzhqeavrhtbe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Firebase Admin SDK
FIREBASE_PROJECT_ID=pratidnya-legal-tech
FIREBASE_SERVICE_ACCOUNT_JSON=

# Concurrency & Incident Monitoring
MAX_CONCURRENT_NLP_JOBS=4
DPBI_REPORTING_WEBHOOK_URL=https://api.asiverticals.me/internal/dpdp/incident-alerts
