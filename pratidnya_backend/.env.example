# ==============================================================================
# PRATIDNYA LEGAL TECH (ASIVERTICALS) — BACKEND ENVIRONMENT TEMPLATE
# Copy this file to .env before starting the FastAPI microservice:
#   cp .env.example .env
# ==============================================================================

# 1. Application Runtime
APP_ENV=DEVELOPMENT
PORT=8000

# 2. Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PAID_TIER=false
ENFORCE_DUMMY_DATA=true

# 3. Kanoon.dev Legal Research API
KANOON_DEV_API_KEY=sk_mock_test_key
MOCK_KANOON_API=true

# 4. Supabase PostgreSQL & pgvector (AWS Mumbai ap-south-1)
SUPABASE_URL=https://edekorlixzhqeavrhtbe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 5. Firebase Admin Authentication SDK
FIREBASE_PROJECT_ID=pratidnya-legal-tech
FIREBASE_SERVICE_ACCOUNT_JSON=

# 6. Concurrency Throttling & Incident Alerting
MAX_CONCURRENT_NLP_JOBS=4
DPBI_REPORTING_WEBHOOK_URL=https://api.asiverticals.me/internal/dpdp/incident-alerts
